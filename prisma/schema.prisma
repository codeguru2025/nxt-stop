generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String
  firstName     String?  // split from `name` going forward; `name` stays in sync on every profile write
  lastName      String?
  homeTown      String?
  isWhatsApp    Boolean  @default(true) // whether `phone` is reachable on WhatsApp — toggle shown on profile
  passwordHash  String
  role          String   @default("customer") // customer | partner | gate_staff | admin
  email         String?  // optional contact address — used for admin daily digest delivery
  capabilities  String[] @default([]) // admin-panel section access, only meaningful when role = admin — see AdminCapability in lib/auth.ts
  avatar        String?
  referralCode  String   @unique @default(cuid())
  points        Int      @default(0)
  totalEarned   Int      @default(0)
  mustResetPassword     Boolean   @default(false) // set on account creation (system-issued one-time password); cleared only by POST /api/auth/set-password
  passwordSetAt         DateTime? // last time the user (not the system) set their own password
  oneTimePasswordUsedAt DateTime? // first successful login with the system-issued password — guards against reuse after that
  isPlatformOwner       Boolean   @default(false) // irrevocable, only ever set via prisma/scripts/seed-platform-owner.ts — never accept this field from any API request body
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tickets           Ticket[]
  orders            Order[]
  referralsMade     Referral[]   @relation("ReferralSource")
  referralsReceived Referral[]   @relation("ReferralTarget")
  partnerProfile    Partner?
  socialPosts       SocialPost[]
  redemptions       Redemption[]
  scanLogs          ScanLog[]
  passwordResetRequests PasswordResetRequest[]
  passwordResetTokens   PasswordResetToken[]
  vouchers              Voucher[]
  referralRewards       ReferralReward[]
  teamMemberships       TeamMember[]
  pushSubscriptions     PushSubscription[]
  changeRequestsMade     ChangeRequest[] @relation("ChangeRequester")
  changeRequestsReviewed ChangeRequest[] @relation("ChangeReviewer")
  eventParticipations    EventParticipant[]
}

// ─── PASSWORD RESETS ─────────────────────────────────────────────────────────

model PasswordResetRequest {
  id          String    @id @default(cuid())
  userId      String
  status      String    @default("pending") // pending | processed | rejected
  reason      String?   // optional note from user
  ip          String?
  processedAt DateTime?
  processedBy String?   // admin user id who handled it
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// Self-service email-verified password reset — separate from the admin-mediated
// PasswordResetRequest above, which stays as a fallback for users without email access.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────
// Insert-only. Deliberately has NO relation to User (nothing cascades into or out
// of it) and NO update/delete route anywhere in the app — that absence is the
// tamper-evidence mechanism. Only a platform-owner account (User.isPlatformOwner)
// may ever read it. See src/lib/auditLog.ts.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  method     String?
  path       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ─── FOUNDERS ────────────────────────────────────────────────────────────────

model Founder {
  id        String   @id @default(cuid())
  name      String
  role      String?
  bio       String?
  image     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── EVENTS ──────────────────────────────────────────────────────────────────

model Event {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String?
  venue            String
  address          String?
  date             DateTime
  endDate          DateTime?
  status           String    @default("draft") // draft | published | live | ended | cancelled
  posterImage      String?
  bannerImage      String?
  videoUrl         String?
  lineup           String?
  hasVirtual       Boolean   @default(false)
  virtualPrice     Decimal   @default(0) @db.Decimal(10, 2)
  virtualStreamUrl String?
  virtualActive    Boolean   @default(false)
  platformFee      Decimal   @default(0.10) @db.Decimal(10, 2)
  lat              Float?
  lng              Float?
  qrCodeUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ticketTypes TicketType[]
  tickets     Ticket[]
  partners    EventPartner[]
  products    Product[]
  socialPosts SocialPost[]
  scanLogs    ScanLog[]
  media       EventMedia[]
  participants EventParticipant[]

  @@index([status, date])
}

model EventMedia {
  id         String   @id @default(cuid())
  eventId    String
  type       String   // image | video | teaser
  url        String
  youtubeUrl String?
  caption    String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── TICKET TYPES ────────────────────────────────────────────────────────────

model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  capacity    Int
  sold        Int      @default(0)
  active      Boolean  @default(true)
  salesChannel String  @default("both") // advance | gate | both — time-window gate, independent of `active`
  color       String   @default("#8B5CF6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  orderItems OrderItem[]

  @@index([eventId])
}

// ─── TICKETS ─────────────────────────────────────────────────────────────────

model Ticket {
  id             String    @id @default(cuid())
  ticketNumber   String    @unique
  qrCode         String    @unique
  userId         String
  eventId        String
  ticketTypeId   String
  orderId        String?   // null for physical/inventory tickets before activation
  status         String    @default("valid") // valid | used | cancelled | refunded | physical
  usedAt         DateTime?
  partnerId      String?
  referralCode   String?
  activationCode String?   @unique  // short code printed on physical ticket stub
  activatedAt    DateTime?
  activatedById  String?
  createdAt      DateTime  @default(now())

  user        User       @relation(fields: [userId], references: [id])
  event       Event      @relation(fields: [eventId], references: [id])
  ticketType  TicketType @relation(fields: [ticketTypeId], references: [id])
  order       Order?     @relation(fields: [orderId], references: [id])
  partner     Partner?   @relation(fields: [partnerId], references: [id])
  scanLogs    ScanLog[]

  @@index([userId])
  @@index([eventId, status])
  @@index([orderId])
  @@index([activationCode])
}

model ScanLog {
  id        String   @id @default(cuid())
  ticketId  String
  eventId   String
  scannedBy String?
  result    String   // valid | already_used | invalid
  deviceId  String?
  createdAt DateTime @default(now())

  ticket  Ticket @relation(fields: [ticketId], references: [id])
  event   Event  @relation(fields: [eventId], references: [id])
  scanner User?  @relation(fields: [scannedBy], references: [id])

  @@index([ticketId])
  @@index([eventId, createdAt])
}

// ─── ORDERS & PAYMENTS ───────────────────────────────────────────────────────

model Order {
  id            String    @id @default(cuid())
  orderNumber   String    @unique
  userId        String
  subtotal      Decimal   @db.Decimal(10, 2)
  platformFees  Decimal   @default(0) @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  status        String    @default("pending") // pending | paid | failed | refunded
  paymentMethod String?
  paymentRef    String?
  paidAt        DateTime?
  partnerId     String?
  referralCode  String?
  guestToken    String?   @unique
  guestPhone    String?
  guestName     String?
  whatsappPhone String?
  whatsappName  String?
  whatsappSentAt DateTime?
  recipientName String?
  email         String?
  emailSentAt   DateTime?
  ecocashPayerPhone String? // orphaned since the EcoCash direct-pay revert — kept (not dropped) because
                            // production has real historical values here; no code reads it anymore
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  tickets Ticket[]
  items   OrderItem[]
  vouchers Voucher[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  ticketTypeId String?
  name         String
  price        Decimal @db.Decimal(10, 2)
  quantity     Int     @default(1)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])
  vouchers   Voucher[]

  @@index([orderId])
  @@index([ticketTypeId])
}

// ─── PARTNERS & AFFILIATES ───────────────────────────────────────────────────

model Partner {
  id                  String   @id @default(cuid())
  userId              String   @unique
  type                String   // dj | influencer | pharmacy | promoter | venue | other
  businessName        String?
  referralCode        String   @unique
  qrCode              String?
  commissionRate      Decimal  @default(10) @db.Decimal(5, 2)
  commissionPerTicket Decimal  @default(0) @db.Decimal(10, 2)
  totalSales          Int      @default(0)
  totalEarned         Decimal  @default(0) @db.Decimal(12, 2)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id])
  eventLinks  EventPartner[]
  tickets     Ticket[]
  referrals   Referral[]
  commissions Commission[]
}

model EventPartner {
  id               String   @id @default(cuid())
  eventId          String
  partnerId        String
  customCommission Decimal? @db.Decimal(10, 2)
  ticketsAllocated Int?
  ticketsSold      Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id])

  @@unique([eventId, partnerId])
}

// Line-up members (DJs, MCs, acts) an admin has given an account, so they get a share
// link without buying a ticket. The public line-up itself stays in Event.lineup (JSON).
model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  name      String   // as billed on the line-up
  role      String   // line-up role: main_act | headline | mc | resident_dj | support_dj | guest_dj | special_guest
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
}

model Commission {
  id        String    @id @default(cuid())
  partnerId String
  orderId   String?
  amount    Decimal   @db.Decimal(10, 2)
  status    String    @default("pending") // pending | paid | cancelled
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

// ─── REFERRALS ───────────────────────────────────────────────────────────────

model Referral {
  id            String   @id @default(cuid())
  sourceUserId  String
  targetUserId  String
  partnerId     String?
  orderId       String?
  pointsAwarded Int      @default(0)
  createdAt     DateTime @default(now())

  source  User     @relation("ReferralSource", fields: [sourceUserId], references: [id])
  target  User     @relation("ReferralTarget", fields: [targetUserId], references: [id])
  partner Partner? @relation(fields: [partnerId], references: [id])
  reward  ReferralReward?

  @@index([sourceUserId])
  @@index([targetUserId])
}

// Cash ledger for the 10%-of-ticket-value customer referral payout — mirrors the
// existing Partner → Commission pattern. Kept separate from `Referral` (a pure
// attribution record) and from `User.points` (the unrelated in-app rewards catalog
// currency, left untouched so nothing else earning points is orphaned).
model ReferralReward {
  id         String    @id @default(cuid())
  referralId String    @unique
  userId     String
  orderId    String
  amount     Decimal   @db.Decimal(10, 2)
  status     String    @default("pending") // pending | paid | cancelled
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  referral Referral @relation(fields: [referralId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ─── REWARDS ─────────────────────────────────────────────────────────────────

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   // free_drink | discounted_ticket | free_entry | bring_friend | vip_upgrade | merchandise
  pointsCost  Int
  stock       Int?
  active      Boolean  @default(true)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  userId    String
  rewardId  String
  points    Int
  status    String   @default("pending") // pending | approved | used | rejected
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([userId])
  @@index([rewardId])
}

model PointsConfig {
  id              String   @id @default(cuid())
  pointsPerSale   Int      @default(10)
  bonusMultiplier Float    @default(1.0)
  referralPercentage Decimal @default(10) @db.Decimal(5, 2) // % of ticket-only subtotal paid to the referrer as cash (ReferralReward)
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// ─── PRODUCTS / STORE ────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  eventId     String?
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  sold        Int      @default(0)
  category    String   @default("drink") // drink | food | merchandise | table | other
  merchType   String?  // tshirt | hoodie | cap | wineglass | tote | vinyl | other
  size        String?  // S | M | L | XL | XXL | One Size | etc
  color       String?
  image       String?
  active      Boolean  @default(true)
  lowStockAt  Int      @default(10)
  isTable     Boolean  @default(false)
  capacityPerUnit Int? // seats covered per unit purchased — only meaningful when isTable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event      Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  vouchers   Voucher[]

  @@index([eventId])
  @@index([category])
}

// ─── PRE-EVENT PURCHASES (vouchers / merch / tables) ─────────────────────────
// Minted one row per unit purchased when an order containing a Product line item
// is fulfilled (see fulfillOrder.ts). Fully separate from Ticket/ScanLog — safer
// than generalizing the live ticket-scanning path for a net-new feature.
model Voucher {
  id           String    @id @default(cuid())
  orderId      String
  orderItemId  String
  productId    String
  userId       String
  eventId      String?
  code         String    @unique
  qrCode       String    @unique
  status       String    @default("unredeemed") // unredeemed | redeemed | cancelled
  redeemedAt   DateTime?
  redeemedById String?
  createdAt    DateTime  @default(now())

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  scanLogs  VoucherScanLog[]

  @@index([orderId])
  @@index([userId])
  @@index([eventId, status])
}

model VoucherScanLog {
  id        String   @id @default(cuid())
  voucherId String
  eventId   String?
  scannedBy String?
  result    String   // valid | already_used | invalid
  deviceId  String?
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@index([voucherId])
  @@index([eventId, createdAt])
}

// ─── STREET TEAMS ─────────────────────────────────────────────────────────────
// Pure grouping/reporting layer over data other phases already produce
// (ReferralReward, Commission) — not a new attribution mechanism of its own.
model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

// ─── SOCIAL FEED ─────────────────────────────────────────────────────────────

model SocialPost {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  type      String   // photo | video
  url       String
  caption   String?
  status    String   @default("pending") // pending | approved | rejected
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
}

// ─── SITE VISITS ─────────────────────────────────────────────────────────────

// One row per page view (and per referral-link click, path /r/CODE). Kept apart from
// AuditLog so visits never bury important actions. Rows older than 90 days are deleted.
model PageView {
  id           String   @id @default(cuid())
  path         String   // pathname only — no query string
  userId       String?  // set when the visitor is logged in
  visitorId    String   // random id in the nxt-vid cookie; ties anonymous visits together
  referralCode String?  // referral link this visit is credited to (click, ?ref=, or nxt-ref cookie)
  source       String?  // where they came from: whatsapp, facebook, instagram, google, direct, …
  device       String?  // mobile | tablet | desktop
  ipHash       String?  // salted hash — raw IPs are never stored
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([referralCode, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
}

// ─── TWO-ADMIN APPROVAL ──────────────────────────────────────────────────────

// A serious admin change (event edit/delete, prices, admin accounts, payouts, …) held
// until a different admin approves it. On approval the original API request is
// replayed as the requester — see src/lib/approvals.ts.
model ChangeRequest {
  id            String    @id @default(cuid())
  action        String    // e.g. event.update — see APPROVAL_ACTIONS in lib/approvals.ts
  capability    String?   // admin-panel section an approver must hold (platform owners always can)
  method        String
  route         String    // route pattern replayed on approval, e.g. /api/admin/events/[id]
  params        Json?     // route params, e.g. { id }
  bodyEnc       String?   // AES-256-GCM encrypted JSON body (may hold passwords); wiped once decided
  bodyHash      String    // de-duplicates identical pending requests
  entityType    String
  entityId      String?
  entityVersion String?   // entity updatedAt when requested — approval fails if it changed since
  title         String    // plain-language summary shown to approvers
  changes       Json      // [{ label, from, to }] — passwords never included
  status        String    @default("pending") // pending | applying | applied | rejected | cancelled | expired | failed
  requestedById String
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  failureReason String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  requestedBy User  @relation("ChangeRequester", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("ChangeReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([requestedById])
}

// ─── PUSH NOTIFICATIONS ─────────────────────────────────────────────────────

// One row per browser/device an admin enabled alerts on (Web Push). Rows whose
// endpoint the push service reports as gone (404/410) are deleted on send.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── SMS ─────────────────────────────────────────────────────────────────────

// SMS credits bought from the gateway, recorded by a platform owner. Credits left =
// sum(credits) − segments of sent SmsMessage rows. A negative row corrects a mistake.
model SmsTopUp {
  id          String   @id @default(cuid())
  credits     Int
  note        String?
  addedById   String
  addedByName String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Every SMS the app tried to send — the ledger behind credits used and the report.
model SmsMessage {
  id         String   @id @default(cuid())
  kind       String   // transactional | otp | promotional
  purpose    String   // what it was for, e.g. order.paid
  phone      String   // masked, e.g. +26377***567
  status     String   // sent | failed | no_credit
  segments   Int      @default(1) // credits it costs (1 per 160-char segment)
  reference  String?  // e.g. the order number
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

// ─── SETTINGS ────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
